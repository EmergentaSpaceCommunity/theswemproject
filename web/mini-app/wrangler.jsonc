// How the page a bot opens inside the messenger is put on Cloudflare (Pages,
// now part of Workers), as static files and nothing else. From this
// directory, signed in with `npx wrangler login`:
//   node ../../scripts/mini-app.mjs && npx wrangler deploy
// The name and the domain are the deployer's own; the address the page is
// given is what a bot is told under "Where the page is hosted". Anybody
// hosting their own copy changes both.
{
  "name": "swem-app",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist" },
  "routes": [{ "pattern": "swem-telegram.emergenta.space", "custom_domain": true }]
}
