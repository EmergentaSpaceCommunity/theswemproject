{
  "name": "swem-workbench-web",
  "version": "0.1.0",
  "private": true,
  "description": "Production Workbench web shell plus the official MCP Apps AppBridge over the Rust host relay.",
  "type": "module",
  "scripts": {
    "test": "node --test theme.test.mjs test/*.test.mjs",
    "build": "npm run typecheck && vite build && npm run build:apps-bridge",
    "build:apps-bridge": "esbuild apps-bridge.entry.mjs --bundle --format=iife --global-name=SwemAppsBundle --outfile=dist/apps-bridge.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@simplewebauthn/browser": "14.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.3.1",
    "shiki": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
