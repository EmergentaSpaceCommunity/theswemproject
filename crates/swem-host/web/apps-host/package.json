{
  "name": "swem-workbench-web",
  "version": "0.1.0",
  "private": true,
  "description": "Production Workbench web shell plus the official MCP Apps AppBridge over the Rust host relay.",
  "type": "module",
  "scripts": {
    "test": "node --test theme.test.mjs test/*.test.mjs",
    "build": "npm run typecheck && vite build && npm run build:apps-bridge",
    "build:apps-bridge": "esbuild apps-bridge.entry.mjs --bundle --format=iife --global-name=SwemAppsBundle --outfile=dist/apps-bridge.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.3.1",
    "shiki": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
